.data
mang: 	.byte 
size: 	.byte
phantu:	.asciiz "So phan tu cua mang: "
nhap:	.asciiz "Nhap mang: "
max: 	.asciiz "\nGia tri lon nhat: "
min: 	.asciiz "\nGia tri nho nhat: "
sum: 	.asciiz "\nTong cac phan tu cua mang: "
pos: 	.asciiz "\nVi tri can tim: "
pos_rec:.asciiz "Vi tri can tim khong phu hop. Vui long nhap lai: "
value_f:.asciiz "Gia tri phan tu can tim: "
enter: 	.asciiz "\n"
space:	.asciiz " "

.text
main:
	li $v0, 4
	la $a0, phantu
	syscall
	
	la $s1, mang
	lb $s0, size
	
	li $v0, 5
	syscall				#Nhap gia tri so phan tu
	move $s0, $v0
	
	li $v0, 4
	la $a0, nhap
	syscall
	
	li $t0, 0
	#Nhap
LOOP_in: 	beq $t0, $s0, EXIT_in
		add $t1, $s1, $t0		#$s1 la thanh ghi chua mang A		
	
		li $v0, 5
		syscall		
		sb $v0, 0($t1)			#Nhap gia tri A[i]
		
		addi $t0, $t0, 1
		j LOOP_in
	
EXIT_in:
	li $t0, 0
LOOP_out:
	beq $t0, $s0, EXIT_out
	add $t1, $s1, $t0
	
	li $v0, 1
	lb $a0, 0($t1)
	syscall
	
	li $v0, 4
	la $a0, space
	syscall
	
	addi $t0, $t0, 1
	j LOOP_out



EXIT_out:
	#Tim MAX
	lb $s2, 0($s1)				#$s2 = A[0] ; $s2 la thanh ghi max
	lb $s3, 0($s1)				#$s3 = A[0] ; $s3 la thanh ghi min
	
	li $t0, 1
LOOP_fmaxmin:
	beq $t0, $s0, EXIT_fmaxmin
	add $t1, $s1, $t0
	lb $t2, 0($t1)				#A[i]
	
	bgt $t2, $s2, MAX			#A[i] > max
	blt $t2, $s3, MIN			#A[i] < min
	addi $t0, $t0, 1
	j LOOP_fmaxmin
	
MAX:	add $s2, $0, $t2				#MAX = A[i]
	addi $t0, $t0, 1
	j LOOP_fmaxmin
	
MIN: 	add $s3, $0, $t2
	addi $t0, $t0, 1
	j LOOP_fmaxmin
	
EXIT_fmaxmin:
	li $v0, 4
	la $a0, max
	syscall

	li $v0, 1
	move $a0, $s2
	syscall
	
	li $v0, 4
	la $a0, min
	syscall
	
	li $v0, 1
	move $a0, $s3
	syscall

	li $s5, 0				#sum = 0
	li $t0, 0
LOOP_sum:
	beq $t0, $s0, EXIT_sum
	add $t1, $t0, $s1
	lb $t2, 0($t1)				#arr[i]	
	
	add $s5, $s5, $t2			#Sum = sum + arr[i]
	
	addi $t0, $t0, 1
	j LOOP_sum

EXIT_sum:
	li $v0, 4
	la $a0, sum
	syscall
	
	li $v0, 1
	move $a0, $s5
	syscall
	
	li $v0, 4
	la $a0, pos
	syscall
	
LOOP_call:
	li $v0, 5
	syscall
	move $s4, $v0			#$s4: vi tri can tim

	addi $t0, $s0, -1
	
	blt $s4, $0, Recall		#pos < 0
	bgt $s4, $t0, Recall		#pos > n
	
	j posf
	
Recall: 
	li $v0, 4
	la $a0, pos_rec
	syscall
	
	j LOOP_call
	
posf: 	add $t0, $s4, $s1
	lb $t1, 0($t0)
	
	li $v0, 4
	la $a0, value_f
	syscall
	
	li $v0, 1
	move $a0, $t1
	syscall

END:
	