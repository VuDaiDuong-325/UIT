.data 
    input_prompt: .asciiz "Nhap vao mot chuoi: " 
    input_buffer: .space 100 
    output_buffer: .space 100 
 
.text 
main:  li $v0, 4           # syscall de in chuoi 
    la $a0, input_prompt    # load dia chi cua thong bao nhap chuoi 
    syscall 
 
    li $v0, 8           # syscall de doc chuoi 
    la $a0, input_buffer    # load dia chi cua bo dem nhap 
    li $a1, 100         # do dai toi da cua chuoi nhap 
    syscall 
 
    # Xuat ra chuoi da nhap (da duoc chinh sua) 
    li $v0, 4               # syscall de in chuoi 
    la $a0, input_buffer    # load dia chi cua bo dem nhap 
    syscall
