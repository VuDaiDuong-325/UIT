	component system is
		port (
			clk_clk                  : in  std_logic                     := 'X';             -- clk
			reset_reset_n            : in  std_logic                     := 'X';             -- reset_n
			pio_sw_export_export     : in  std_logic_vector(5 downto 0)  := (others => 'X'); -- export
			pio_hex_ms_export_export : out std_logic_vector(31 downto 0);                    -- export
			pio_hex_h_export_export  : out std_logic_vector(15 downto 0)                     -- export
		);
	end component system;

