transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+D:/HK6/Digital_System_Design_with_HDL/Labs/LAB2/Bai2 {D:/HK6/Digital_System_Design_with_HDL/Labs/LAB2/Bai2/bcd_4bit_to_led7.v}
vlog -vlog01compat -work work +incdir+D:/HK6/Digital_System_Design_with_HDL/Labs/LAB4 {D:/HK6/Digital_System_Design_with_HDL/Labs/LAB4/sram_controller.v}


vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L cycloneii_ver -L rtl_work -L work -voptargs="+acc"  tb_sram_controller

add wave *
view structure
view signals
run -all
