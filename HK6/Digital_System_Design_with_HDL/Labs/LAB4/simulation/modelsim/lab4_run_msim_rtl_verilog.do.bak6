transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+D:/HK6/Digital_System_Design_with_HDL/Labs/LAB4 {D:/HK6/Digital_System_Design_with_HDL/Labs/LAB4/single_port_RAM.v}

vlog -vlog01compat -work work +incdir+D:/HK6/Digital_System_Design_with_HDL/Labs/LAB4 {D:/HK6/Digital_System_Design_with_HDL/Labs/LAB4/tb_ram_wave.v}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L cycloneii_ver -L rtl_work -L work -voptargs="+acc"  tb_ram_wave

add wave *
view structure
view signals
run -all
