// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "11/20/2025 21:03:12"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    DD
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module DD_vlg_sample_tst(
	CLK,
	Res,
	START,
	sampler_tx
);
input  CLK;
input [7:0] Res;
input  START;
output sampler_tx;

reg sample;
time current_time;
always @(CLK or Res or START)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module DD_vlg_check_tst (
	R,
	sampler_rx
);
input [11:0] R;
input sampler_rx;

reg [11:0] R_expected;

reg [11:0] R_prev;

reg [11:0] R_expected_prev;

reg [11:0] last_R_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:1] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 1'b1;
end

// update real /o prevs

always @(trigger)
begin
	R_prev = R;
end

// update expected /o prevs

always @(trigger)
begin
	R_expected_prev = R_expected;
end


// expected R[ 11 ]
initial
begin
	R_expected[11] = 1'bX;
end 
// expected R[ 10 ]
initial
begin
	R_expected[10] = 1'bX;
end 
// expected R[ 9 ]
initial
begin
	R_expected[9] = 1'bX;
end 
// expected R[ 8 ]
initial
begin
	R_expected[8] = 1'bX;
end 
// expected R[ 7 ]
initial
begin
	R_expected[7] = 1'bX;
end 
// expected R[ 6 ]
initial
begin
	R_expected[6] = 1'bX;
end 
// expected R[ 5 ]
initial
begin
	R_expected[5] = 1'bX;
end 
// expected R[ 4 ]
initial
begin
	R_expected[4] = 1'bX;
end 
// expected R[ 3 ]
initial
begin
	R_expected[3] = 1'bX;
end 
// expected R[ 2 ]
initial
begin
	R_expected[2] = 1'bX;
end 
// expected R[ 1 ]
initial
begin
	R_expected[1] = 1'bX;
end 
// expected R[ 0 ]
initial
begin
	R_expected[0] = 1'bX;
end 
// generate trigger
always @(R_expected or R)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected R = %b | ",R_expected_prev);
	$display("| real R = %b | ",R_prev);
`endif
	if (
		( R_expected_prev[0] !== 1'bx ) && ( R_prev[0] !== R_expected_prev[0] )
		&& ((R_expected_prev[0] !== last_R_exp[0]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[0] = R_expected_prev[0];
	end
	if (
		( R_expected_prev[1] !== 1'bx ) && ( R_prev[1] !== R_expected_prev[1] )
		&& ((R_expected_prev[1] !== last_R_exp[1]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[1] = R_expected_prev[1];
	end
	if (
		( R_expected_prev[2] !== 1'bx ) && ( R_prev[2] !== R_expected_prev[2] )
		&& ((R_expected_prev[2] !== last_R_exp[2]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[2] = R_expected_prev[2];
	end
	if (
		( R_expected_prev[3] !== 1'bx ) && ( R_prev[3] !== R_expected_prev[3] )
		&& ((R_expected_prev[3] !== last_R_exp[3]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[3] = R_expected_prev[3];
	end
	if (
		( R_expected_prev[4] !== 1'bx ) && ( R_prev[4] !== R_expected_prev[4] )
		&& ((R_expected_prev[4] !== last_R_exp[4]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[4] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[4] = R_expected_prev[4];
	end
	if (
		( R_expected_prev[5] !== 1'bx ) && ( R_prev[5] !== R_expected_prev[5] )
		&& ((R_expected_prev[5] !== last_R_exp[5]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[5] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[5] = R_expected_prev[5];
	end
	if (
		( R_expected_prev[6] !== 1'bx ) && ( R_prev[6] !== R_expected_prev[6] )
		&& ((R_expected_prev[6] !== last_R_exp[6]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[6] = R_expected_prev[6];
	end
	if (
		( R_expected_prev[7] !== 1'bx ) && ( R_prev[7] !== R_expected_prev[7] )
		&& ((R_expected_prev[7] !== last_R_exp[7]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[7] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[7] = R_expected_prev[7];
	end
	if (
		( R_expected_prev[8] !== 1'bx ) && ( R_prev[8] !== R_expected_prev[8] )
		&& ((R_expected_prev[8] !== last_R_exp[8]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[8] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[8] = R_expected_prev[8];
	end
	if (
		( R_expected_prev[9] !== 1'bx ) && ( R_prev[9] !== R_expected_prev[9] )
		&& ((R_expected_prev[9] !== last_R_exp[9]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[9] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[9] = R_expected_prev[9];
	end
	if (
		( R_expected_prev[10] !== 1'bx ) && ( R_prev[10] !== R_expected_prev[10] )
		&& ((R_expected_prev[10] !== last_R_exp[10]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[10] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[10] = R_expected_prev[10];
	end
	if (
		( R_expected_prev[11] !== 1'bx ) && ( R_prev[11] !== R_expected_prev[11] )
		&& ((R_expected_prev[11] !== last_R_exp[11]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R[11] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_R_exp[11] = R_expected_prev[11];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#480000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module DD_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg [7:0] Res;
reg START;
// wires                                               
wire [11:0] R;

wire sampler;                             

// assign statements (if any)                          
DD i1 (
// port map - connection between master ports and signals/registers   
	.CLK(CLK),
	.R(R),
	.Res(Res),
	.START(START)
);

// CLK
initial
begin
	CLK = 1'b1;
	# 2000;
	repeat(23)
	begin
		CLK = 1'b0;
		CLK = #10000 1'b1;
		# 10000;
	end
	CLK = 1'b0;
	CLK = #10000 1'b1;
end 

// START
initial
begin
	START = 1'b1;
	START = #20000 1'b0;
end 
// Res[ 7 ]
initial
begin
	Res[7] = 1'b0;
	Res[7] = #20000 1'b1;
	Res[7] = #20000 1'b0;
end 
// Res[ 6 ]
initial
begin
	Res[6] = 1'b0;
end 
// Res[ 5 ]
initial
begin
	Res[5] = 1'b0;
end 
// Res[ 4 ]
initial
begin
	Res[4] = 1'b0;
end 
// Res[ 3 ]
initial
begin
	Res[3] = 1'b0;
end 
// Res[ 2 ]
initial
begin
	Res[2] = 1'b0;
	Res[2] = #20000 1'b1;
	Res[2] = #20000 1'b0;
end 
// Res[ 1 ]
initial
begin
	Res[1] = 1'b0;
	Res[1] = #20000 1'b1;
	Res[1] = #20000 1'b0;
end 
// Res[ 0 ]
initial
begin
	Res[0] = 1'b0;
	Res[0] = #20000 1'b1;
	Res[0] = #20000 1'b0;
end 

DD_vlg_sample_tst tb_sample (
	.CLK(CLK),
	.Res(Res),
	.START(START),
	.sampler_tx(sampler)
);

DD_vlg_check_tst tb_out(
	.R(R),
	.sampler_rx(sampler)
);
endmodule

