// port map - connection between master ports and signals/registers   
	.ALUControl(ALUControl),
	.ALUresu(ALUresu),
	.CLK(CLK),
	.Dmem(Dmem),
	.Instr(Instr),
	.Reg1(Reg1),
	.Reg2(Reg2)
);

// CLK
initial
begin
	repeat(12)
	begin
		CLK = 1'b0;
		CLK = #40000 1'b1;
		# 40000;
	end
	CLK = 1'b0;
end 
