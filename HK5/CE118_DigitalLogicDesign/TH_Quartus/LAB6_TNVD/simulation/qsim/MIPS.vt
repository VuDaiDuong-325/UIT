module Top_final_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg [31:0] Instr;
// wires                                               
wire [3:0] ALUControl;
wire [31:0] ALUresu;
wire [31:0] Dmem;
wire [31:0] Reg1;
wire [31:0] Reg2;

wire sampler;                             

// assign statements (if any)                          
