	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module MIPS_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg CLR;
// wires                                               
wire [15:0] ALU;
wire [15:0] DMEM;
wire outPCSrc;
wire [15:0] PC;
wire [15:0] RD1;
wire [15:0] RD2;

wire sampler;                             

// assign statements (if any)                          
MIPS i1 (
// port map - connection between master ports and signals/registers   
	.ALU(ALU),
	.CLK(CLK),
	.CLR(CLR),
	.DMEM(DMEM),
	.outPCSrc(outPCSrc),
	.PC(PC),
	.RD1(RD1),
	.RD2(RD2)
);

// CLK
initial
begin
	CLK = 1'b1;
	# 2000;
	repeat(8)
	begin
		CLK = 1'b0;
		CLK = #10000 1'b1;
		# 10000;
	end
	CLK = 1'b0;
	CLK = #10000 1'b1;
end 

// CLR
initial
begin
	CLR = 1'b1;
	CLR = #10000 1'b0;
end 

MIPS_vlg_sample_tst tb_sample (
	.CLK(CLK),
	.CLR(CLR),
	.sampler_tx(sampler)
);

MIPS_vlg_check_tst tb_out(
	.ALU(ALU),
	.DMEM(DMEM),
	.outPCSrc(outPCSrc),
	.PC(PC),
	.RD1(RD1),
	.RD2(RD2),
	.sampler_rx(sampler)
);
endmodule

