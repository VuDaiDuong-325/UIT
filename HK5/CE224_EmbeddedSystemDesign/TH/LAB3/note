Interrupt Set-enable Registers

enable Interrupt NVIC cho Tim2 ?
-> enable 28th register from 0 to 1 for TIM2

#define NVIC_ISER0 (*(volatile unsign int *)0xE000E100)
NVIC_ISER0 |= (1<<28)

